{
  "dashboard": {
    "uid": "world-cup-2026",
    "title": "World Cup 2026 Monitor",
    "tags": ["world-cup", "fifa-2026", "k3s"],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 39,
    "time": { "from": "now-3h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Node CPU Usage",
        "type": "gauge",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU %"
          }
        ]
      },
      {
        "id": 2,
        "title": "Node Memory Used",
        "type": "gauge",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 75 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
            "legendFormat": "Memory %"
          }
        ]
      },
      {
        "id": 3,
        "title": "world-cup-web CPU & Memory",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "rate(process_cpu_seconds_total{job=\"world-cup-web\"}[5m])",
            "legendFormat": "CPU cores"
          },
          {
            "refId": "B",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "process_resident_memory_bytes{job=\"world-cup-web\"} / 1024 / 1024",
            "legendFormat": "RSS MiB"
          }
        ]
      },
      {
        "id": 4,
        "title": "Golden Boot (goals)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 0, "y": 8 },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "yellow" } } },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_golden_boot_goals"
          }
        ]
      },
      {
        "id": 5,
        "title": "Tournament Goals",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 4, "y": 8 },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_total_goals_count"
          }
        ]
      },
      {
        "id": 6,
        "title": "Matches Played",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 8, "y": 8 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_completed_matches_count"
          }
        ]
      },
      {
        "id": 7,
        "title": "Avg Goals / Match",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 12, "y": 8 },
        "fieldConfig": { "defaults": { "decimals": 2 } },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_average_goals_per_match"
          }
        ]
      },
      {
        "id": 8,
        "title": "High-Scoring Matches (4+ goals)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 16, "y": 8 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_high_scoring_matches_count"
          }
        ]
      },
      {
        "id": 9,
        "title": "Largest Margin of Victory",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 4, "x": 20, "y": 8 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_largest_margin_of_victory_goals"
          }
        ]
      },
      {
        "id": 10,
        "title": "Tournament Records",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "options": { "textMode": "value_and_name", "orientation": "horizontal" },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_hat_tricks_total",
            "legendFormat": "Hat-tricks",
            "instant": true
          },
          {
            "refId": "B",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_penalty_shootout_matches_total",
            "legendFormat": "Penalty shootouts",
            "instant": true
          },
          {
            "refId": "C",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_extra_time_matches_total",
            "legendFormat": "Extra-time matches",
            "instant": true
          }
        ]
      },
      {
        "id": 11,
        "title": "Upstream Refresh Health",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "rate(wc_upstream_refresh_successes_total[5m])",
            "legendFormat": "successful refreshes/s"
          },
          {
            "refId": "B",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_upstream_errors_total",
            "legendFormat": "cumulative upstream errors"
          },
          {
            "refId": "C",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_cache_age_seconds",
            "legendFormat": "cache age (s)"
          }
        ]
      },
      {
        "id": 12,
        "title": "Champion",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 22 },
        "options": {
          "textMode": "name",
          "colorMode": "background",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^team$/" }
        },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "yellow" } } },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "expr": "wc_tournament_champion_info == 1",
            "legendFormat": "{{team}}",
            "instant": true
          }
        ]
      }
    ]
  },
  "overwrite": true
}
